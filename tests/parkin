import sys
from pathlib import Path
import cv2


ROOT = Path(__file__).resolve().parent.parent


VISION_PATH = (
    ROOT /
    "models" /
    "raspberry pi 5" /
    "vision"
)


CONFIG_PATH = (
    ROOT /
    "models" /
    "raspberry pi 5" /
    "config" /
    "config.yaml"
)


IMAGE_PATH = (
    "tests/datastets/obstacles/images 2/img_45_jpg.rf.21f9be44071376cdd605999a43f1d3d8.jpg"
)


sys.path.append(str(VISION_PATH))


from parking_detection import estimate_parking_zone
from hsv_config import load_hsv_thresholds


frame = cv2.imread(IMAGE_PATH)

if frame is None:
    raise Exception("No se pudo cargar imagen")


thresholds = load_hsv_thresholds(
    str(CONFIG_PATH)
)


result = estimate_parking_zone(
    frame,
    thresholds
)


print(result)


if result.parking_lot_detected:

    x,y = result.parking_lot_position

    cv2.circle(
        frame,
        (x,y),
        8,
        (0,255,0),
        -1
    )

    cv2.putText(
        frame,
        "PARKING",
        (x,y-10),
        cv2.FONT_HERSHEY_SIMPLEX,
        1,
        (0,255,0),
        2
    )


cv2.imshow(
    "PARKING TEST",
    frame
)


cv2.waitKey(0)
cv2.destroyAllWindows()